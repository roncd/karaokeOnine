# Copier ce fichier vers .env à la racine avant de lancer Docker Compose :
# cp .env.docker.example .env

# PostgreSQL
POSTGRES_USER=karaoke
POSTGRES_PASSWORD=karaoke
POSTGRES_DB=karaoke_dev
POSTGRES_PORT=5432

# Services (changez si un port est déjà utilisé sur votre machine)
BACKEND_PORT=3001
FRONTEND_PORT=8081
NODE_ENV=production

# URL utilisée par le navigateur pour appeler l'API (doit correspondre à BACKEND_PORT)
EXPO_PUBLIC_API_URL=http://localhost:3001

# LiveKit (optionnel)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://localhost:7880
