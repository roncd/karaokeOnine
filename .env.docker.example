# Copier ce fichier vers .env à la racine avant de lancer Docker Compose :
# cp .env.docker.example .env
#
# Builds plus rapides (à exporter dans le terminal avant docker compose) :
# export DOCKER_BUILDKIT=1
# export COMPOSE_DOCKER_CLI_BUILD=1
#
# Dev sans rebuild à chaque changement :
#   docker compose down
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build
#   → http://localhost:8081
#
# Prod (nginx + export Expo) :
#   docker compose up --build
#   → http://localhost:8081  (si FRONTEND_PORT=8081 dans .env)

# PostgreSQL
POSTGRES_USER=karaoke
POSTGRES_PASSWORD=karaoke
POSTGRES_DB=karaoke_dev
POSTGRES_PORT=5432

# Services (changez si un port est déjà utilisé sur votre machine)
BACKEND_PORT=3001
FRONTEND_PORT=8081
FRONTEND_DEV_PORT=8081
NODE_ENV=production

# URL utilisée par le navigateur pour appeler l'API (doit correspondre à BACKEND_PORT)
EXPO_PUBLIC_API_URL=http://localhost:3001

# LiveKit (optionnel)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://localhost:7880
